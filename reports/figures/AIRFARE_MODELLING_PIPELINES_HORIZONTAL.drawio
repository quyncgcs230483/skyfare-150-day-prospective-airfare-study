        <mxCell id="box_32" value="&lt;b&gt;Strictly prior fare anchor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Prediction-time-valid comparator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#F4F6F7;strokeColor=#9AA6AD;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="685.6" y="766" width="308.8" height="132" as="geometry" />
        </mxCell>
        <mxCell id="box_33" value="&lt;b&gt;Compare model with temporal baseline&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;MAPE, MAE, RMSE and R²; block-specific and pooled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
