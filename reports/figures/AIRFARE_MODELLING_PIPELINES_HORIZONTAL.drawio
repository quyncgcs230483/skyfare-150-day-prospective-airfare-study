  <diagram id="horizontal-pipeline-3" name="Probabilistic forecasting">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="text_1" value="Probabilistic forecasting modelling pipeline" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=30;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="36" y="18" width="1608" height="46" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="01" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#3B8D8A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="76" width="38" height="26" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="POINT-IN-TIME TASK CONSTRUCTION" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=16;fontColor=#667681;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="76" width="1568" height="26" as="geometry" />
        </mxCell>
        <mxCell id="box_4" value="&lt;b&gt;Build point-in-time regression frame&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Route, airline, calendar, DUD, regime and legal history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="34.0" y="112" width="386.5" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_5" value="&lt;b&gt;Calculate strictly prior fare anchor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Reference available before prediction time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="442.5" y="112" width="386.5" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_6" value="&lt;b&gt;Construct relative log-fare target&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Exact future fare or time-consistent interpolation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="851.0" y="112" width="386.5" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_7" value="&lt;b&gt;Specify seven conditional quantiles&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;q05, q10, q25, q50, q75, q90 and q95&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1259.5" y="112" width="386.5" height="124" as="geometry" />
        </mxCell>
        <mxCell id="text_11" value="02" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#3B8D8A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="270" width="38" height="26" as="geometry" />
        </mxCell>
        <mxCell id="text_12" value="TEMPORAL SELECTION, QUANTILE ENSEMBLE AND CALIBRATION" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=16;fontColor=#667681;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="270" width="1568" height="26" as="geometry" />
        </mxCell>
        <mxCell id="box_13" value="&lt;b&gt;128-day rolling-origin validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Screen F02–F04; validate F05–F06 by WIS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="330" width="276" height="136" as="geometry" />
        </mxCell>
        <mxCell id="box_14" value="&lt;b&gt;CatBoost MultiQuantile&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Depth 7; jointly estimates seven quantiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1018" y="304" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="box_15" value="&lt;b&gt;XGBoost quantile regressor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Depth 7; estimates same seven quantiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1018" y="438" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="box_16" value="&lt;b&gt;Equal-weight mean of six fitted members&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Two finalists × three random seeds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
