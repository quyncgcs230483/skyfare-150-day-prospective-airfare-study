        </mxCell>
        <mxCell id="box_4" value="&lt;b&gt;Define candidate schedule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Route, airline, departure time and DUD known&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="34.0" y="112" width="304.8" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_5" value="&lt;b&gt;Build point-in-time row&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Only information available before query timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="360.8" y="112" width="304.8" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_6" value="&lt;b&gt;Calculate strictly prior fare anchor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Latest completed observation; no future leakage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="687.6" y="112" width="304.8" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_7" value="&lt;b&gt;Construct future-fare target&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Exact fare or time-consistent interpolation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1014.4000000000001" y="112" width="304.8" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box_8" value="&lt;b&gt;Build exact observed-fare history&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Masked ordered sequence; target excluded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=20;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1341.2" y="112" width="304.8" height="124" as="geometry" />
        </mxCell>
        <mxCell id="text_13" value="02" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#3B8D8A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="270" width="38" height="26" as="geometry" />
        </mxCell>
        <mxCell id="text_14" value="TEMPORAL SELECTION AND RECURRENT ENSEMBLE" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=16;fontColor=#667681;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="270" width="1568" height="26" as="geometry" />
        </mxCell>
        <mxCell id="box_15" value="&lt;b&gt;128-day rolling-origin validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Screen F02–F04; validate F05–F06 by MAPE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="330" width="276" height="136" as="geometry" />
        </mxCell>
        <mxCell id="box_16" value="&lt;b&gt;Exact-history GRU regressor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;64 units; Huber loss; anchor-relative log fare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1018" y="304" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="box_17" value="&lt;b&gt;Exact-history LSTM regressor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;64 units; Huber loss; anchor-relative log fare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1018" y="438" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="box_18" value="&lt;b&gt;Equal-weight mean of six fitted members&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;GRU and LSTM × three random seeds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="666" y="348" width="276" height="136" as="geometry" />
        </mxCell>
        <mxCell id="box_19" value="&lt;b&gt;Transform output to fare in VND&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Prior anchor × exp(mean relative log fare)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=19;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="348" width="276" height="136" as="geometry" />
        </mxCell>
        <mxCell id="text_26" value="03" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#3B8D8A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="585" width="38" height="26" as="geometry" />
        </mxCell>
        <mxCell id="text_27" value="PROSPECTIVE EVALUATION AND PRODUCTION REFIT" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=16;fontColor=#667681;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="585" width="1568" height="26" as="geometry" />
        </mxCell>
        <mxCell id="box_28" value="&lt;b&gt;Freeze complete specification before Test 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Features, hyperparameters, seeds and ensemble rule fixed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="24.0" y="670" width="308.8" height="152" as="geometry" />
        </mxCell>
        <mxCell id="box_29" value="&lt;b&gt;Test 1: 11 unseen days&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;29 Jul–8 Aug; committed before labels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
