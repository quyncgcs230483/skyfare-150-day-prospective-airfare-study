        </mxCell>
        <mxCell id="box_30" value="&lt;b&gt;Test 2: 11 unseen days&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;9–19 Aug; expanding-window update&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#EDF4FB;strokeColor=#6C9DC4;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="354.8" y="766" width="308.8" height="132" as="geometry" />
        </mxCell>
        <mxCell id="box_31" value="&lt;b&gt;Predicted future fare in VND&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667681&quot; style=&quot;font-size:16px&quot;&gt;Frozen ensemble output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=0;glass=0;fillColor=#E9F5F4;strokeColor=#5A9D9A;strokeWidth=1.7;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacingTop=6;spacingBottom=6;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="685.6" y="616" width="308.8" height="132" as="geometry" />
