        <mxCell id="text_1" value="Classification modelling pipeline" style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontFamily=Helvetica;fontSize=30;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1">
